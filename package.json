{
  "name": "dao-for-clubs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dao/frontend dev",
    "dev:chain": "pnpm --filter @dao/contracts dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm test && pnpm build && pnpm typecheck",
    "artifacts:export": "pnpm --filter @dao/contracts artifacts:export"
  }
}
